# Copy to .env for local development. Values starting with INSECURE_DEV_ are placeholders:
# they work locally and are rejected by the production guards.

# Runtime
APP_ENV=local
HOST_KIND=server
APP_BASE_URL=http://localhost:3000

# Secrets (at least 32 characters; production must replace every placeholder)
APP_ENCRYPTION_KEY=INSECURE_DEV_encryption_key_change_me_32chars
CRON_SECRET=INSECURE_DEV_cron_secret_change_me_32chars_min
PASSWORD_PEPPER=INSECURE_DEV_password_pepper_change_me_32chars

# Database: runtime role (app) and migration role (migrate)
DATABASE_URL=postgres://rentcar_app:INSECURE_DEV_app_role@postgres:5432/rentcar
DIRECT_DATABASE_URL=postgres://rentcar_migrator:INSECURE_DEV_migrator_role@postgres:5432/rentcar

# System SMTP: Mailpit in the local stack (UI on http://localhost:8025). Production uses a TLS provider.
SYSTEM_SMTP_HOST=mailpit
SYSTEM_SMTP_PORT=2525
SYSTEM_SMTP_SECURITY=none
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASSWORD=
SYSTEM_SMTP_FROM_ADDRESS=noreply@rentcar.localhost
SYSTEM_SMTP_FROM_NAME=RentCar
SYSTEM_ADMIN_EMAIL=owner@rentcar.localhost
SMTP_DEV_ALLOW_PRIVATE=true

# Compose bootstrap only (local stack): superuser and role passwords
POSTGRES_ADMIN_PASSWORD=INSECURE_DEV_postgres_admin
ROLE_MIGRATOR_PASSWORD=INSECURE_DEV_migrator_role
ROLE_APP_PASSWORD=INSECURE_DEV_app_role
ROLE_BACKUP_PASSWORD=INSECURE_DEV_backup_role

# Compose profiles started by default: seed (dev data) and the mail sink
COMPOSE_PROFILES=seed,mail
